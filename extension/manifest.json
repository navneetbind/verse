{
  "manifest_version": 3,
  "name": "Verse",
  "version": "0.2.0",
  "description": "Shows YouTube Music synced lyrics (word-level) in the Verse macOS menu-bar app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lyra-ytm@local",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://lrclib.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
